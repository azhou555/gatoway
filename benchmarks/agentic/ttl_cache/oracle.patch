+_MISSING = object()
+
+
+class TTLCache:
+    def __init__(self, ttl_seconds, clock):
+        self.ttl_seconds = ttl_seconds
+        self._clock = clock
+        self._values = {}
+
+    def put(self, key, value):
+        if self.ttl_seconds <= 0:
+            self._values.pop(key, None)
+            return
+        self._values[key] = (value, self._clock())
+
+    def get(self, key):
+        item = self._values.get(key, _MISSING)
+        if item is _MISSING:
+            return None
+
+        value, inserted_at = item
+        if self.ttl_seconds <= 0 or self._clock() - inserted_at >= self.ttl_seconds:
+            del self._values[key]
+            return None
+        return value
+
+    def get_or_load(self, key, loader):
+        item = self._values.get(key, _MISSING)
+        if item is not _MISSING:
+            value, inserted_at = item
+            if self.ttl_seconds > 0 and self._clock() - inserted_at < self.ttl_seconds:
+                return value
+            self._values.pop(key, None)
+
+        value = loader()
+        self.put(key, value)
+        return value
