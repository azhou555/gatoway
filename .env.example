# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://gatoway:gatoway@localhost:5432/gatoway

# Only needed if docker-compose.yml env vars are overridden
POSTGRES_USER=gatoway
POSTGRES_PASSWORD=gatoway
POSTGRES_DB=gatoway

# NRP API key -- all provider tiers are NRP-hosted models behind one
# OpenAI-compatible endpoint. Get one at https://nrp.ai/llmtoken/
NRP_API_KEY=
