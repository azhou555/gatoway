+import threading
+
+
+class WebhookProcessor:
+    def __init__(self):
+        self._completed = {}
+        self._inflight = {}
+        self._lock = threading.Lock()
+
+    def process(self, event_id, payload, handler):
+        while True:
+            with self._lock:
+                if event_id in self._completed:
+                    return self._completed[event_id]
+
+                pending = self._inflight.get(event_id)
+                if pending is None:
+                    pending = threading.Event()
+                    self._inflight[event_id] = pending
+                    owner = True
+                else:
+                    owner = False
+
+            if owner:
+                break
+            pending.wait()
+
+        try:
+            result = handler(payload)
+        except BaseException:
+            with self._lock:
+                self._inflight.pop(event_id, None)
+                pending.set()
+            raise
+
+        with self._lock:
+            self._completed[event_id] = result
+            self._inflight.pop(event_id, None)
+            pending.set()
+        return result
